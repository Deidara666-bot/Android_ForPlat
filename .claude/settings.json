{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 40
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git tag -l:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff check:*)",
      "Bash(python -m ruff format --check:*)",
      "Bash(python -m mypy:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(adb devices:*)",
      "Bash(adb version)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(bash scripts/dev/check.sh:*)",
      "Bash(bash scripts/dev/init-env.sh)"
    ],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(adb shell:*)",
      "Bash(adb install:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb pull:*)",
      "Bash(adb push:*)",
      "Bash(docker compose down:*)",
      "Bash(alembic downgrade:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(rm -rf:*)",
      "Edit(/docs/dev/**)",
      "Bash(git push * --delete *)",
      "Bash(git remote add:*)"
    ],
    "deny": [
      "Edit(./context/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(./samples/**)",
      "Read(./malware/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git filter-branch:*)",
      "Bash(git tag -d:*)",
      "Bash(git lfs:*)",
      "Bash(adb root:*)",
      "Bash(adb shell su:*)",
      "Bash(adb disable-verity:*)",
      "Bash(adb reboot bootloader:*)",
      "Bash(fastboot:*)"
    ]
  }
}
